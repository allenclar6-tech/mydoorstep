FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# The site itself calls /api on its own domain; this address is used by live order tracking and by any
# non-DOORSTEP host (previews). Public values only: never put a secret in a VITE_ variable.
ARG VITE_API_BASE_URL=https://api.mydoorstep.com.co
ARG VITE_MAP_PUBLIC_TOKEN
ARG VITE_MAPBOX_ACCESS_TOKEN
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_MAP_PUBLIC_TOKEN=${VITE_MAP_PUBLIC_TOKEN}
ENV VITE_MAPBOX_ACCESS_TOKEN=${VITE_MAPBOX_ACCESS_TOKEN}
RUN npm run build \
  && node deploy/zimaos/nginx/make-apk-redirect.mjs dist /app/doorstep-apk-redirect.conf

FROM nginx:1.27-alpine
# Visitor IPs from CF-Connecting-IP are trusted only when every request comes through Cloudflare (Tunnel or proxy).
ENV TRUST_CLOUDFLARE_IP=off
# The image's entrypoint renders /etc/nginx/templates/*.template into /etc/nginx/conf.d/ at start.
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /etc/nginx/snippets
COPY deploy/zimaos/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/zimaos/nginx/doorstep-headers.conf deploy/zimaos/nginx/doorstep-api-proxy.conf /etc/nginx/snippets/
COPY --from=build /app/doorstep-apk-redirect.conf /etc/nginx/snippets/doorstep-apk-redirect.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
