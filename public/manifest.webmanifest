{
  "id": "/",
  "name": "DOORSTEP — Sapele delivery",
  "short_name": "DOORSTEP",
  "description": "Food, groceries, shops and parcels, delivered across Sapele. Businesses and riders run their work here too.",
  "lang": "en-NG",
  "dir": "ltr",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#faf8f2",
  "theme_color": "#ffc244",
  "categories": ["food", "shopping", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png?v=3", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Order food", "short_name": "Food", "url": "/food?source=shortcut", "icons": [{ "src": "/icons/icon-192.png?v=3", "sizes": "192x192" }] },
    { "name": "Groceries", "short_name": "Groceries", "url": "/groceries?source=shortcut", "icons": [{ "src": "/icons/icon-192.png?v=3", "sizes": "192x192" }] },
    { "name": "Send a package", "short_name": "Send", "url": "/send?source=shortcut", "icons": [{ "src": "/icons/icon-192.png?v=3", "sizes": "192x192" }] },
    { "name": "My orders", "short_name": "Orders", "url": "/account/orders?source=shortcut", "icons": [{ "src": "/icons/icon-192.png?v=3", "sizes": "192x192" }] }
  ]
}
