DATABASE_URL=postgresql://doorstep_user:change_me@localhost:5432/doorstep
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
AUTH_SECRET=replace_with_secure_random_secret
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Configure PAYSTACK_SECRET_KEY only in the API host environment. Never expose it
# in a VITE_ variable, browser response, client bundle, or source control.
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback
# Server-only key (at least 32 random characters) that encrypts saved Paystack card tokens.
# Saved cards stay switched off until this is set. Changing it makes existing saved cards unusable.
CARD_TOKEN_ENCRYPTION_KEY=
# Add-a-card verification charge in kobo (10000 = NGN 100, allowed 5000-20000); refunded automatically.
CARD_VERIFICATION_AMOUNT_MINOR=10000
# Pay riders (and anything not settled by split) with Paystack Transfers from the DOORSTEP balance.
# Turn on Transfers in the Paystack dashboard first; set "true" only then. Off = record bank payouts manually.
PAYSTACK_TRANSFERS_ENABLED=false
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
# Separate server key: restrict to Routes API + Places API (New), and API-host IPs.
GOOGLE_NAVIGATION_API_KEY=
MAPBOX_TOKEN=
# Server-only Mapbox token for parcel pricing (Directions API). Keep it secret; do NOT add a URL
# restriction (server requests send no browser Referer). Never put it in a VITE_ variable.
MAPBOX_SERVER_TOKEN=
CLOUDINARY_URL=
FIREBASE_CONFIGURATION=
# Public Mapbox token (pk.*) served to the website at runtime by GET /api/map/config, so maps work even if
# the website was built without VITE_MAP_PUBLIC_TOKEN. Same value as VITE_MAP_PUBLIC_TOKEN; URL-restrict it.
MAPBOX_PUBLIC_TOKEN=

# ---- Sign-in & verification codes ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=
# Google sign-in (customers). OAuth 2.0 *Web application* client ID from Google Cloud Console.
# Public by design; no client secret is needed for the Google Identity Services button flow.
GOOGLE_CLIENT_ID=
# SMS codes: "termii" or "twilio". Leave empty to pick termii when TERMII_API_KEY is set.
SMS_PROVIDER=
TERMII_API_KEY=
# The base URL shown in your Termii dashboard (account-specific), e.g. https://v3.api.termii.com
TERMII_BASE_URL=
# An approved Termii sender ID (alphanumeric, registered for Nigerian traffic).
TERMII_SENDER_ID=
# "dnd" reaches numbers on Do-Not-Disturb (recommended for one-time codes); "generic" otherwise.
TERMII_CHANNEL=dnd
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp codes via Meta WhatsApp Cloud API with an approved AUTHENTICATION template (copy-code button).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v26.0

# ---- Registry checks (optional; admins can always verify manually) ----
# Ninja (ninja.ng) secret key. sk_sandbox_... uses the free sandbox; sk_... is live and billed per check.
NINJA_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:5173
PRIVATE_UPLOAD_DIR=./private-uploads

VITE_API_BASE_URL=http://localhost:4000
VITE_MAP_PROVIDER=mapbox
VITE_NAVIGATION_PROVIDER=mapbox
# Public browser token (pk.*). Restrict it in the Mapbox account to your site URLs and public scopes.
VITE_MAP_PUBLIC_TOKEN=
# Public browser key: restrict to Maps JavaScript API and approved website referrers.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
VITE_PAYMENTS_PROVIDER=paystack
