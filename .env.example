DATABASE_URL=postgresql://doorstep_user:change_me@localhost:5432/doorstep
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
AUTH_SECRET=replace_with_secure_random_secret
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Configure PAYSTACK_SECRET_KEY only in the API host environment. Never expose it
# in a VITE_ variable, browser response, client bundle, or source control.
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback
# Server-only key (at least 32 random characters) that encrypts saved Paystack card tokens.
# Saved cards stay switched off until this is set. Changing it makes existing saved cards unusable.
CARD_TOKEN_ENCRYPTION_KEY=
# Add-a-card verification charge in kobo (5000 = NGN 50); refunded automatically.
CARD_VERIFICATION_AMOUNT_MINOR=5000
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
# Separate server key: restrict to Routes API + Places API (New), and API-host IPs.
GOOGLE_NAVIGATION_API_KEY=
MAPBOX_TOKEN=
# Server-only Mapbox token for parcel pricing (Directions API). Keep it secret; do NOT add a URL
# restriction (server requests send no browser Referer). Never put it in a VITE_ variable.
MAPBOX_SERVER_TOKEN=
CLOUDINARY_URL=
FIREBASE_CONFIGURATION=
EMAIL_PROVIDER=resend
SMS_PROVIDER=twilio
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_APP_URL=http://localhost:5173
PRIVATE_UPLOAD_DIR=./private-uploads

VITE_API_BASE_URL=http://localhost:4000
VITE_MAP_PROVIDER=mapbox
VITE_NAVIGATION_PROVIDER=mapbox
# Public browser token (pk.*). Restrict it in the Mapbox account to your site URLs and public scopes.
VITE_MAP_PUBLIC_TOKEN=
# Public browser key: restrict to Maps JavaScript API and approved website referrers.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
VITE_PAYMENTS_PROVIDER=paystack
