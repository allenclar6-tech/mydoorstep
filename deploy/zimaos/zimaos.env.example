# DOORSTEP on ZimaOS: production settings.
# Copy to .env in this folder (cp zimaos.env.example .env; chmod 600 .env) and fill it in on the server.
# .env is git-ignored and Docker-ignored. Never commit it, never paste it into chat.
#
#   [COPY]  copy the exact value from Render: mydoorstep-api, Environment tab
#   [NEW]   generate a new value on the server (command shown)
#   [SET]   fixed value; leave as is unless the domain changes
#   [OPT]   optional; that feature stays off while it is empty

# ---------------------------------------------------------------- Server folders (ZimaOS)
# [SET] Where the database, uploads and backups are kept. /DATA is ZimaOS's data disk; confirm with `df -h /DATA`.
DOORSTEP_DATA=/DATA/AppData/doorstep/data
# [OPT] Put backups on a different disk (e.g. a USB/second drive under /media) so one disk failure can't take both.
DOORSTEP_BACKUPS=
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- Database
# [NEW] Letters and digits only (it is placed inside a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL is built by docker-compose.yml from this password; do not set it here.

# ---------------------------------------------------------------- Website and routing
# [SET] Host port the web container listens on, for Nginx Proxy Manager / LAN tests. Not opened on the router.
WEB_HOST_PORT=8090
# [SET] "on" ONLY when every request reaches the server through Cloudflare (Tunnel, or proxied DNS with the
# origin locked to Cloudflare). Otherwise "off", so visitors can't fake their address to dodge rate limits.
TRUST_CLOUDFLARE_IP=on
# [COPY] Token of the doorstep-zimaos tunnel (Zero Trust > Networks > Tunnels > doorstep-zimaos). The production
# site is served through it: always run compose with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

WEB_ORIGIN=https://mydoorstep.com.co
# [SET] Other browser origins allowed to call the API (comma-separated, https only).
WEB_ORIGINS=https://www.mydoorstep.com.co
NEXT_PUBLIC_APP_URL=https://mydoorstep.com.co
PAYMENT_CALLBACK_URL=https://mydoorstep.com.co/payment/callback

# Built into the website (public values only, never a secret):
VITE_API_BASE_URL=https://api.mydoorstep.com.co
# [COPY] Public Mapbox token (pk.*), URL-restricted to mydoorstep.com.co. Same as MAPBOX_PUBLIC_TOKEN.
VITE_MAP_PUBLIC_TOKEN=

# ---------------------------------------------------------------- Payments (Paystack)
PAYMENT_PROVIDER=paystack
# [COPY] Live keys in production (sk_live_ / pk_live_). A test server uses the TEST keys and must not share a
# database copy with production while its background loops are on.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# [OPT] Comma-separated Paystack channels, e.g. card,bank_transfer,ussd. Empty = Paystack's default.
PAYSTACK_CHANNELS=
# [COPY] MUST be the exact Render value: changing it makes every saved card unusable.
CARD_TOKEN_ENCRYPTION_KEY=
CARD_VERIFICATION_AMOUNT_MINOR=10000
# [COPY] "true" only if Transfers are enabled in the Paystack dashboard.
PAYSTACK_TRANSFERS_ENABLED=false

# ---------------------------------------------------------------- Maps
# [COPY] Public browser token served to the site at runtime by /api/map/config.
MAPBOX_PUBLIC_TOKEN=
# [OPT] Secret server token for parcel routing; falls back to MAPBOX_PUBLIC_TOKEN when empty.
MAPBOX_SERVER_TOKEN=
MAPBOX_TOKEN=
# [OPT] Google keys, only if Google maps/navigation are used.
GOOGLE_MAPS_API_KEY=
GOOGLE_NAVIGATION_API_KEY=

# ---------------------------------------------------------------- Sign-in codes (email / SMS / WhatsApp)
EMAIL_PROVIDER=resend
# [COPY]
RESEND_API_KEY=
# [COPY] A sender verified in Resend, e.g. DOORSTEP <no-reply@mydoorstep.com.co>
VERIFICATION_FROM_EMAIL=
# [COPY] Google sign-in OAuth Web client ID (public). Add https://mydoorstep.com.co as an authorised origin.
GOOGLE_CLIENT_ID=
# [COPY] "termii" or "twilio"; empty picks termii when TERMII_API_KEY is set.
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v26.0

# ---------------------------------------------------------------- Registry checks
# [COPY] [OPT] ninja.ng key; sk_sandbox_... is free, sk_... is billed per check.
NINJA_SECRET_KEY=
NINJA_BASE_URL=

# ---------------------------------------------------------------- Kept in the database (leave empty)
# Web push keys and the delivery-code secret are stored in the database and move with the data import.
# Set these only to override what the database holds (changing push keys stops existing phone subscriptions).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=
DELIVERY_CODE_SECRET=

# ---------------------------------------------------------------- Background loops (leave unset in production)
# DISPATCH_SWEEP=off   PAYOUT_SWEEP=off   PUSH_SWEEP=off   only for test servers.
