generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ApplicationStatus {
  PENDING_APPROVAL
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum BusinessRegistrationType {
  REGISTERED
  NOT_REGISTERED
}

enum BusinessVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  NON_REGISTERED
  ACTION_REQUIRED
  REJECTED
}

enum StoreType {
  RESTAURANT
  GROCERY
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum RiderNetwork {
  DOORSTEP_POOL
  BUSINESS_OWNED
}

enum RestaurantMemberRole {
  OWNER
  MANAGER
  FINANCE
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  RESTAURANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  SUCCESSFUL
  FAILED
  ABANDONED
  EXPIRED
  AMOUNT_MISMATCH
  REFUNDED
}

enum DeliveryStatus {
  AVAILABLE
  REQUESTED
  ACCEPTED
  GOING_TO_RESTAURANT
  ARRIVED_AT_RESTAURANT
  PICKED_UP
  GOING_TO_CUSTOMER
  DELIVERED
  CANCELLED
}

enum ParcelStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  SEARCHING_FOR_RIDER
  RIDER_ASSIGNED
  RIDER_EN_ROUTE_TO_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMOTION
  ACCOUNT
  DELIVERY
  SYSTEM
  SECURITY
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  phone             String?          @unique
  passwordHash      String?
  role              UserRole
  status            UserStatus       @default(ACTIVE)
  firstName         String
  lastName          String
  preferredName     String?
  dateOfBirth       DateTime?
  preferredLanguage String?
  dietaryPreference String?
  deliveryNotes     String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customer          Customer?
  restaurantUsers   RestaurantUser[]
  rider             Rider?
  notifications     Notification[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]       @relation("ActorAuditLogs")
  applicationReviews ApplicationReview[] @relation("ApplicationReviewActor")
  addresses         Address[]
  reviews           Review[]
  favorites         Favorite[]
  referralsSent     Referral[]       @relation("Referrer")
  referralsReceived Referral[]       @relation("Referred")
  orders            Order[]          @relation("CustomerOrders")
  parcelBookings    ParcelBooking[]  @relation("CustomerParcels")
  savedCards        SavedCard[]
  authIdentities    AuthIdentity[]
  cardVerifications CardVerification[]
  sessions          Session[]
  profileImageKey   String?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model VerificationCode {
  id          String    @id @default(cuid())
  destination String
  channel     String
  codeHash    String
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([destination, channel, expiresAt])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Restaurant {
  id                String                   @id @default(cuid())
  name              String
  slug              String                   @unique
  description       String?
  cuisineCategory   String?
  coverImageUrl     String?
  prepTimeMinutes   Int?
  minimumOrderMinor Int                     @default(0)
  storeType         StoreType                @default(RESTAURANT)
  phone             String?
  email             String?
  address           String
  cityId            String?
  city              City?                    @relation(fields: [cityId], references: [id])
  status            ApplicationStatus        @default(PENDING_APPROVAL)
  ratingAverage     Decimal                  @default(0) @db.Decimal(3, 2)
  ratingCount       Int                      @default(0)
  openingTime       String?
  closingTime       String?
  daysOpen          Json?
  temporarilyClosed Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  users             RestaurantUser[]
  categories        MenuCategory[]
  menuItems         MenuItem[]
  orders            Order[]
  reviews           Review[]
  promotions        Promotion[]
  deliveryZones     RestaurantDeliveryZone[]
  application       RestaurantApplication?
  payouts           RestaurantPayout[]
  favorites         Favorite[]
  businessRiders    Rider[]                  @relation("BusinessOwnedRiders")
}

model RestaurantApplication {
  id             String               @id @default(cuid())
  restaurantId   String               @unique
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ownerName      String
  ownerPhone     String
  ownerEmail     String
  submittedAt    DateTime             @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  status         ApplicationStatus    @default(PENDING_APPROVAL)
  reviewNote     String?
  businessCategory   String?
  registrationNumber String?
  whatsApp           String?
  identityType   String?
  identityNumber String?
  deliveryPreference String?
  registrationType   BusinessRegistrationType?
  businessVerificationStatus BusinessVerificationStatus @default(NOT_SUBMITTED)
  businessVerificationNote   String?
  businessVerifiedAt         DateTime?
  businessVerifiedById       String?
  documents      RestaurantDocument[]
}

model RestaurantDocument {
  id            String                @id @default(cuid())
  applicationId String
  application   RestaurantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  storageKey    String
  verifiedAt    DateTime?
  createdAt     DateTime              @default(now())
}

model RestaurantUser {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         RestaurantMemberRole @default(OWNER)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
}

model Rider {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(PENDING_APPROVAL)
  availability   RiderAvailability @default(OFFLINE)
  vehicleType    String?
  vehicleDetails String?
  network        RiderNetwork      @default(DOORSTEP_POOL)
  restaurantId   String?
  restaurant     Restaurant?       @relation("BusinessOwnedRiders", fields: [restaurantId], references: [id])
  ratingAverage  Decimal           @default(0) @db.Decimal(3, 2)
  ratingCount    Int               @default(0)
  application    RiderApplication?
  documents      RiderDocument[]
  orders         Order[]
  deliveries     Delivery[]
  locations      RiderLocation[]
  payouts        RiderPayout[]
  parcelBookings ParcelBooking[]   @relation("AssignedParcelRider")
  availabilityLatitude   Decimal?  @db.Decimal(10, 7)
  availabilityLongitude  Decimal?  @db.Decimal(10, 7)
  availabilityAccuracyM  Int?
  availabilityLocatedAt  DateTime?
  availabilityChangedAt  DateTime?

  @@index([restaurantId, status])
  @@index([status, availability])
}

model RiderApplication {
  id                String                  @id @default(cuid())
  riderId           String                  @unique
  rider             Rider                   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  submittedAt       DateTime                @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  status            ApplicationStatus       @default(PENDING_APPROVAL)
  reviewNote        String?
  identityType      String?
  identityNumber    String?
  emergencyName     String?
  emergencyPhone    String?
  preferredArea     String?
  typicalAvailability String?
  vehicleOwnership String?
  identityCheckConsentAt DateTime?
  identityDocuments RiderIdentityDocument[]
}

model ApplicationReview {
  id              String            @id @default(cuid())
  applicationType String
  applicationId   String
  previousStatus  ApplicationStatus
  status          ApplicationStatus
  note            String?
  actorId         String?
  actor           User?             @relation("ApplicationReviewActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([applicationType, applicationId, createdAt])
}

model RiderDocument {
  id         String    @id @default(cuid())
  riderId    String
  rider      Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type       String
  storageKey String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model RiderIdentityDocument {
  id            String           @id @default(cuid())
  applicationId String
  application   RiderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  storageKey    String
  verifiedAt    DateTime?
  createdAt     DateTime         @default(now())
}

model Country {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  states       State[]
  serviceAreas ServiceArea[]
}

model State {
  id           String        @id @default(cuid())
  name         String
  countryId    String
  country      Country       @relation(fields: [countryId], references: [id])
  cities       City[]
  serviceAreas ServiceArea[]

  @@unique([countryId, name])
}

model City {
  id           String         @id @default(cuid())
  name         String
  stateId      String
  state        State          @relation(fields: [stateId], references: [id])
  zones        DeliveryZone[]
  restaurants  Restaurant[]
  serviceAreas ServiceArea[]
  addresses    Address[]

  @@unique([stateId, name])
}

model ServiceArea {
  id        String   @id @default(cuid())
  countryId String
  stateId   String
  cityId    String
  country   Country  @relation(fields: [countryId], references: [id])
  state     State    @relation(fields: [stateId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  enabled   Boolean  @default(false)
  currency  String   @default("NGN")
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, stateId, cityId])
  @@index([enabled])
}

model DeliveryZone {
  id            String                   @id @default(cuid())
  name          String
  cityId        String
  city          City                     @relation(fields: [cityId], references: [id])
  baseFeeMinor  Int
  perKmFeeMinor Int                      @default(0)
  maxRadiusKm   Decimal?                 @db.Decimal(8, 2)
  active        Boolean                  @default(true)
  restaurants   RestaurantDeliveryZone[]
  orders        Order[]

  @@unique([cityId, name])
}

model RestaurantDeliveryZone {
  restaurantId String
  zoneId       String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone         DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([restaurantId, zoneId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  cityId      String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?    @relation(fields: [cityId], references: [id])
  label       String
  addressLine String
  landmark    String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([cityId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String        @id @default(cuid())
  restaurantId String
  categoryId   String?
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  priceMinor   Int
  imageUrl     String?
  available    Boolean       @default(true)
  prepMinutes  Int?
  options      MenuOption[]
  orderItems   OrderItem[]
  favorites    Favorite[]

  @@index([restaurantId, available])
}

model MenuOption {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  priceMinor Int      @default(0)
  active     Boolean  @default(true)
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  idempotencyKey     String?           @unique
  customerId         String
  restaurantId       String
  riderId            String?
  deliveryZoneId     String?
  customer           User              @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id])
  rider              Rider?            @relation(fields: [riderId], references: [id])
  deliveryZone       DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id])
  items              OrderItem[]
  delivery           Delivery?
  payment            Payment?
  commission         Commission?
  reviews            Review[]
  restaurantPayout   RestaurantPayout?
  riderPayout        RiderPayout?
  addressSnapshot    String
  landmarkSnapshot   String?
  latitude           Decimal?          @db.Decimal(10, 7)
  longitude          Decimal?          @db.Decimal(10, 7)
  subtotalMinor      Int
  deliveryFeeMinor   Int
  serviceFeeMinor    Int
  discountMinor      Int               @default(0)
  totalMinor         Int
  status             OrderStatus       @default(PENDING_PAYMENT)
  createdAt          DateTime          @default(now())
  paidAt             DateTime?
  acceptedAt         DateTime?
  preparedAt         DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  @@index([customerId, createdAt])
  @@index([restaurantId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  menuItemId      String?
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
  nameSnapshot    String
  unitPriceMinor  Int
  quantity        Int
  instructions    String?
  optionsSnapshot Json?
}

model Delivery {
  id          String         @id @default(cuid())
  orderId     String?        @unique
  parcelBookingId String?    @unique
  riderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Cascade)
  requestedRiderId String?
  requestExpiresAt DateTime?
  rider       Rider?         @relation(fields: [riderId], references: [id])
  status      DeliveryStatus @default(AVAILABLE)
  requestedAt DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  @@index([riderId, status])
  @@index([requestedRiderId, status])
}

model RiderLocation {
  id         String   @id @default(cuid())
  riderId    String
  rider      Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryId String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recordedAt DateTime @default(now())

  @@index([riderId, recordedAt])
}

model ParcelBooking {
  id                   String        @id @default(cuid())
  reference            String        @unique
  idempotencyKey       String?       @unique
  customerId           String
  customer             User          @relation("CustomerParcels", fields: [customerId], references: [id])
  riderId              String?
  rider                Rider?        @relation("AssignedParcelRider", fields: [riderId], references: [id])
  serviceCode          String
  serviceName          String
  pickupAddress        String
  pickupLatitude       Decimal       @db.Decimal(10, 7)
  pickupLongitude      Decimal       @db.Decimal(10, 7)
  pickupContactName    String
  pickupContactPhone   String
  pickupNotes          String?
  dropoffAddress       String
  dropoffLatitude      Decimal       @db.Decimal(10, 7)
  dropoffLongitude     Decimal       @db.Decimal(10, 7)
  recipientName        String
  recipientPhone       String
  packageDescription   String
  packageSize          String
  deliveryInstructions String?
  distanceMeters       Int
  durationSeconds      Int
  routeGeometry        Json
  routeProvider        String
  baseFeeMinor         Int
  distanceFeeMinor     Int
  minimumFareAdjustmentMinor Int     @default(0)
  serviceFeeMinor      Int
  totalMinor           Int
  currency             String        @default("NGN")
  pricingSnapshot      Json
  status               ParcelStatus  @default(PENDING_PAYMENT)
  riderRating          Int?
  paidAt               DateTime?
  assignedAt           DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  cancelledByRole      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  delivery             Delivery?
  payment              Payment?
  events               ParcelEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([riderId, status])
}

model ParcelEvent {
  id         String        @id @default(cuid())
  bookingId  String
  booking    ParcelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status     ParcelStatus
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([bookingId, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String?       @unique
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcelBookingId String?    @unique
  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Cascade)
  provider     String
  method       String        @default("PAYSTACK")
  reference    String        @unique
  amountMinor  Int
  status       PaymentStatus @default(PENDING)
  expiresAt    DateTime?
  verificationMethod String?
  providerTransactionId String?
  instructionsSnapshot Json?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id                String   @id @default(cuid())
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])
  type              String
  amountMinor       Int
  providerReference String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([providerReference])
}

model Commission {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  percentage  Decimal  @db.Decimal(5, 2)
  amountMinor Int
  createdAt   DateTime @default(now())
}

model RestaurantPayout {
  id           String       @id @default(cuid())
  restaurantId String
  orderId      String       @unique
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  amountMinor  Int
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
}

model RiderPayout {
  id          String       @id @default(cuid())
  riderId     String
  orderId     String       @unique
  rider       Rider        @relation(fields: [riderId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
  amountMinor Int
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
}

model Promotion {
  id           String      @id @default(cuid())
  name         String
  code         String?     @unique
  type         String
  valueMinor   Int?
  percentage   Decimal?    @db.Decimal(5, 2)
  startsAt     DateTime
  endsAt       DateTime
  usageLimit   Int?
  active       Boolean     @default(true)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  orderId      String?
  user         User       @relation(fields: [userId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])
  rating       Int
  body         String?
  moderatedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([userId, orderId])
  @@index([restaurantId, createdAt])
}

model Favorite {
  id           String      @id @default(cuid())
  userId       String
  restaurantId String?
  menuItemId   String?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  menuItem     MenuItem?   @relation(fields: [menuItemId], references: [id])

  @@unique([userId, restaurantId, menuItemId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SupportTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  category     String
  description  String
  attachments  Json?
  status       String           @default("OPEN")
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  messages     SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  senderType String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Referral {
  id         String  @id @default(cuid())
  code       String  @unique
  referrerId String
  referredId String?
  referrer   User    @relation("Referrer", fields: [referrerId], references: [id])
  referred   User?   @relation("Referred", fields: [referredId], references: [id])
  status     String  @default("PENDING")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// Reusable Paystack card authorizations. DOORSTEP never sees or stores card numbers;
// the authorization code is encrypted at rest and only usable with the Paystack secret key.
model SavedCard {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCipher   String
  signature             String
  email                 String
  brand                 String?
  bank                  String?
  last4                 String
  expMonth              String
  expYear               String
  createdAt             DateTime  @default(now())
  lastUsedAt            DateTime?
  removedAt             DateTime?

  @@unique([userId, signature])
  @@index([userId, removedAt])
}

// Small verification charge used to add a card from the account page; refunded automatically.
model CardVerification {
  id           String    @id @default(cuid())
  reference    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinor  Int
  status       String    @default("PENDING")
  refundStatus String?
  savedCardId  String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
}

/// A way of signing in that is not the account password (currently Google). `subject` is the provider's
/// stable user id (Google `sub`), never the email.
model AuthIdentity {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  subject    String
  email      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, subject])
  @@unique([userId, provider])
}

/// Result of an automated registry check (e.g. CAC lookup, NIN match) run by an admin. Stores the verdict and
/// a minimal summary only, never the full registry record.
model VerificationCheck {
  id                String   @id @default(cuid())
  subjectType       String
  subjectId         String
  provider          String
  checkType         String
  outcome           String
  summary           Json?
  providerReference String?
  actorId           String?
  createdAt         DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}
